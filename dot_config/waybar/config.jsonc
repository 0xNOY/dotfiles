{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 12,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["mpris"],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "backlight",
    "pulseaudio",
    "battery",
    "clock",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by": "number"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": true
  },
  "mpris": {
    "format": "{player_icon} {artist} - {title}",
    "format-paused": "󰏤 {artist} - {title}",
    "max-length": 48,
    "player-icons": {
      "default": "󰎈",
      "spotify": " "
    },
    "tooltip-format": "{player}: {album}"
  },
  "cpu": {
    "interval": 1,
    "format": "  {usage:3}%"
  },
  "memory": {
    "interval": 1,
    "format": "  {used:0.1f}G"
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰖩  {essid}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰖪  Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "/usr/bin/ghostty --gtk-single-instance=false --class=com.noy.nmtui -e nmtui"
  },
  "backlight": {
    "format": "󰃟  {percent:3}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume:3}%",
    "format-muted": "󰖁  Muted",
    "format-icons": ["󰕿 ", "󰖀 ", "󰕾 "],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity:3}%",
    "format-charging": "󰂄 {capacity:3}%",
    "format-plugged": "󰂄 {capacity:3}%",
    "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂁", "󰁹"]
  },
  "clock": {
    "interval": 1,
    "format": "{:%Y-%m-%d %a %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8,
    "icons": {
      "Fcitx": "input-keyboard-symbolic",
      "blueman": "bluetooth-symbolic"
    }
  }
}
